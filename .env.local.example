# 本日の配置機能用の環境変数。
# このファイルをコピーして .env.local を作成し、実際の値を入れてください。
# .env.local はコミットされません（.gitignore済み）。
#
# どちらもSupabaseダッシュボードの Project Settings > API で取得できます。
# NEXT_PUBLIC_ を付けないこと（読み書きとも常にサーバー側でのみ使う）。

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# "anon" / "public" キー（読み取り用）
SUPABASE_ANON_KEY=

# "service_role" / "secret" キー（書き込み用）。絶対にクライアントに渡さないこと。
SUPABASE_SERVICE_ROLE_KEY=
